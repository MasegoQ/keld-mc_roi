<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KELD Matrix — Commercialisation & ROI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root {
  --navy: #0F1E35;
  --navy-mid: #1B2A4A;
  --navy-light: #2A3F62;
  --gold: #C9A84C;
  --gold-light: #E8C96A;
  --gold-pale: rgba(201,168,76,0.12);
  --teal: #1D9E75;
  --teal-pale: rgba(29,158,117,0.1);
  --cream: #F8F6F0;
  --cream-dark: #EDE9DF;
  --red: #9B3A1D;
  --text: #1B2A4A;
  --text-mid: #4A5568;
  --text-light: #8A9AB5;
  --border: rgba(27,42,74,0.1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--cream);
  color: var(--text);
  overflow-x: hidden;
}

/* ---- NOISE TEXTURE OVERLAY ---- */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1000;
  opacity: 0.4;
}

/* ---- NAV ---- */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 18px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(248,246,240,0.88);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.02em;
}
.nav-logo span { color: var(--gold); }
.nav-links { display: flex; gap: 32px; }
.nav-links a {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-mid);
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--navy); }

/* ---- HERO ---- */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 48px 80px;
  background: var(--navy);
  position: relative;
  overflow: hidden;
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(201,168,76,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(201,168,76,0.06) 1px, transparent 1px);
  background-size: 60px 60px;
}

.hero-glow {
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,168,76,0.15) 0%, transparent 70%);
  top: -100px; right: -100px;
}
.hero-glow-2 {
  position: absolute;
  width: 400px; height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(29,158,117,0.1) 0%, transparent 70%);
  bottom: 100px; left: 200px;
}

.hero-tag {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.15em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 24px;
  opacity: 0;
  animation: fadeUp 0.8s 0.2s forwards;
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(48px, 7vw, 96px);
  font-weight: 900;
  line-height: 0.95;
  color: #fff;
  letter-spacing: -0.03em;
  max-width: 800px;
  margin-bottom: 32px;
  opacity: 0;
  animation: fadeUp 0.8s 0.4s forwards;
}

.hero-title em {
  font-style: normal;
  color: var(--gold);
}

.hero-desc {
  font-size: 16px;
  color: rgba(255,255,255,0.55);
  max-width: 520px;
  line-height: 1.7;
  margin-bottom: 48px;
  font-weight: 300;
  opacity: 0;
  animation: fadeUp 0.8s 0.6s forwards;
}

.hero-stats {
  display: flex;
  gap: 48px;
  opacity: 0;
  animation: fadeUp 0.8s 0.8s forwards;
}

.hero-stat-value {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
}
.hero-stat-value span { color: var(--gold); }
.hero-stat-label {
  font-size: 12px;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-top: 4px;
}

.hero-divider {
  width: 1px;
  background: rgba(255,255,255,0.1);
  align-self: stretch;
}

.scroll-hint {
  position: absolute;
  bottom: 32px;
  right: 48px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.scroll-hint::before {
  content: '';
  width: 24px; height: 1px;
  background: rgba(255,255,255,0.2);
}

/* ---- SECTIONS ---- */
section {
  padding: 100px 48px;
}

.section-tag {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.section-tag::before {
  content: '';
  width: 32px; height: 1px;
  background: var(--gold);
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--navy);
  margin-bottom: 16px;
}

.section-sub {
  font-size: 16px;
  color: var(--text-mid);
  line-height: 1.7;
  font-weight: 300;
  max-width: 560px;
  margin-bottom: 56px;
}

/* ---- DARK SECTION ---- */
.dark-section {
  background: var(--navy);
  color: #fff;
}
.dark-section .section-title { color: #fff; }
.dark-section .section-sub { color: rgba(255,255,255,0.5); }

/* ---- METRIC GRID ---- */
.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  margin-bottom: 64px;
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}

.metric-card {
  background: #fff;
  padding: 28px 24px;
  position: relative;
  transition: background 0.2s;
}
.metric-card:hover { background: var(--cream); }
.metric-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--gold);
  opacity: 0;
  transition: opacity 0.2s;
}
.metric-card:hover::after { opacity: 1; }

.metric-label {
  font-size: 11px;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 12px;
  font-weight: 500;
}
.metric-value {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
}
.metric-note {
  font-size: 12px;
  color: var(--text-light);
}
.mv-green { color: var(--teal); }
.mv-navy { color: var(--navy); }
.mv-gold { color: #9A6F00; }
.mv-red { color: var(--red); }

/* ---- DARK METRICS ---- */
.dark-metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 64px;
}
.dark-metric {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  padding: 24px;
  transition: background 0.2s;
}
.dark-metric:hover { background: rgba(255,255,255,0.07); }
.dark-metric .metric-label { color: rgba(255,255,255,0.35); }
.dark-metric .metric-value { color: #fff; }
.dark-metric .metric-note { color: rgba(255,255,255,0.3); }

/* ---- CHART CARDS ---- */
.chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
.chart-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; margin-bottom: 24px; }
.chart-full { grid-column: 1 / -1; }

.chart-card {
  background: #fff;
  border-radius: 16px;
  padding: 28px;
  border: 1px solid var(--border);
}
.dark-section .chart-card {
  background: rgba(255,255,255,0.04);
  border-color: rgba(255,255,255,0.08);
}
.chart-card-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--navy);
  margin-bottom: 4px;
  letter-spacing: -0.01em;
}
.dark-section .chart-card-title { color: #fff; }
.chart-card-sub {
  font-size: 12px;
  color: var(--text-light);
  margin-bottom: 20px;
  line-height: 1.5;
}
.dark-section .chart-card-sub { color: rgba(255,255,255,0.35); }

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 16px;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-mid);
  font-weight: 400;
}
.dark-section .legend-item { color: rgba(255,255,255,0.5); }
.swatch {
  width: 10px; height: 10px;
  border-radius: 2px;
  flex-shrink: 0;
}

/* ---- CALC BOX ---- */
.calc-box {
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24px;
}
.dark-section .calc-box { border-color: rgba(255,255,255,0.08); }

.calc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}
.dark-section .calc-row { border-color: rgba(255,255,255,0.06); }
.calc-row:last-child { border-bottom: none; }
.calc-row.total {
  background: var(--gold-pale);
  font-weight: 600;
  font-size: 15px;
}
.dark-section .calc-row.total { background: rgba(201,168,76,0.1); }
.calc-label { color: var(--text-mid); }
.dark-section .calc-label { color: rgba(255,255,255,0.5); }
.calc-value { font-family: 'DM Mono', monospace; font-size: 13px; font-weight: 500; }
.cv-green { color: var(--teal); }
.cv-red { color: var(--red); }
.cv-navy { color: var(--navy); }
.cv-gold { color: #9A6F00; }

/* ---- HIGHLIGHT BOX ---- */
.highlight {
  background: var(--teal-pale);
  border-left: 3px solid var(--teal);
  border-radius: 0 12px 12px 0;
  padding: 20px 24px;
  margin-bottom: 32px;
  font-size: 14px;
  color: #085041;
  line-height: 1.7;
}
.highlight strong { color: var(--teal); font-weight: 600; }
.dark-section .highlight {
  background: rgba(29,158,117,0.1);
  border-color: var(--teal);
  color: rgba(255,255,255,0.7);
}

/* ---- OWNERSHIP GRID ---- */
.owner-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 48px;
}
.owner-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 24px;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}
.owner-card:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(27,42,74,0.08); }
.owner-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}
.owner-card.navy::before { background: var(--navy-mid); }
.owner-card.teal::before { background: var(--teal); }
.owner-card.gold::before { background: var(--gold); }
.owner-card.red::before { background: #8B6A1D; }
.owner-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 4px;
  margin-bottom: 12px;
  font-family: 'DM Mono', monospace;
}
.badge-navy { background: rgba(27,42,74,0.08); color: var(--navy-mid); }
.badge-teal { background: rgba(29,158,117,0.1); color: #085041; }
.badge-gold { background: rgba(201,168,76,0.12); color: #7A5A00; }
.badge-amber { background: rgba(186,117,23,0.1); color: #7A4800; }
.owner-card h4 { font-size: 16px; font-weight: 600; color: var(--navy); margin-bottom: 8px; }
.owner-card p { font-size: 13px; color: var(--text-mid); line-height: 1.6; }

/* ---- PHASE TIMELINE ---- */
.phase-timeline { display: flex; flex-direction: column; gap: 0; margin-bottom: 48px; }
.phase-item {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 0;
}
.phase-spine {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.phase-dot {
  width: 40px; height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  font-family: 'Playfair Display', serif;
  color: #fff;
  flex-shrink: 0;
  z-index: 1;
}
.phase-line {
  flex: 1;
  width: 1px;
  background: var(--border);
  margin: 4px 0;
}
.phase-item:last-child .phase-line { display: none; }
.phase-body {
  padding: 0 0 32px 20px;
}
.phase-body h4 { font-size: 15px; font-weight: 600; color: var(--navy); margin-bottom: 6px; padding-top: 8px; }
.phase-body p { font-size: 13px; color: var(--text-mid); line-height: 1.6; }

/* ---- FEE TABLE ---- */
.fee-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 24px;
  font-size: 13px;
}
.fee-table th {
  background: var(--navy);
  color: rgba(255,255,255,0.7);
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 12px 16px;
  text-align: left;
}
.fee-table td {
  padding: 14px 16px;
  border-top: 1px solid var(--border);
  vertical-align: top;
  background: #fff;
}
.fee-table tr:hover td { background: var(--cream); }
.stage-name { font-weight: 600; color: var(--navy); font-size: 13px; }
.stage-sub { font-size: 11px; color: var(--text-light); margin-top: 2px; }
.fee-amount { font-family: 'DM Mono', monospace; font-weight: 500; color: var(--navy); }
.fee-type {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 4px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.ft-consulting { background: rgba(27,42,74,0.08); color: var(--navy-mid); }
.ft-licence { background: rgba(29,158,117,0.1); color: #085041; }

/* ---- SCENARIO TABS ---- */
.scenario-tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 20px;
  background: rgba(27,42,74,0.06);
  padding: 4px;
  border-radius: 10px;
  width: fit-content;
}
.s-tab {
  padding: 8px 18px;
  border-radius: 7px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  border: none;
  background: transparent;
  color: var(--text-mid);
  transition: all 0.2s;
  letter-spacing: 0.01em;
}
.s-tab.active {
  background: var(--navy);
  color: #fff;
  box-shadow: 0 2px 8px rgba(27,42,74,0.2);
}
.dark-section .scenario-tabs { background: rgba(255,255,255,0.06); }
.dark-section .s-tab { color: rgba(255,255,255,0.4); }
.dark-section .s-tab.active { background: rgba(255,255,255,0.15); color: #fff; }

/* ---- ROI TABLE ---- */
.roi-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 13px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--border);
}
.dark-section .roi-table { border-color: rgba(255,255,255,0.08); }
.roi-table th {
  background: var(--navy);
  color: rgba(255,255,255,0.6);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 10px 16px;
  text-align: right;
  font-weight: 500;
}
.roi-table th:first-child { text-align: left; }
.roi-table td {
  padding: 11px 16px;
  border-top: 1px solid var(--border);
  background: #fff;
  text-align: right;
  font-family: 'DM Mono', monospace;
  font-size: 12px;
  color: var(--text-mid);
}
.dark-section .roi-table td { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.05); color: rgba(255,255,255,0.5); }
.roi-table td:first-child { text-align: left; font-family: 'DM Sans', sans-serif; color: var(--text); }
.dark-section .roi-table td:first-child { color: rgba(255,255,255,0.7); }
.roi-table td.positive { color: var(--teal); }
.roi-table td.negative { color: var(--red); }
.roi-table tr:hover td { background: var(--cream); }
.dark-section .roi-table tr:hover td { background: rgba(255,255,255,0.05); }

/* ---- FOOTNOTE ---- */
.fn {
  font-size: 11px;
  color: var(--text-light);
  line-height: 1.6;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}
.dark-section .fn { color: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.06); }

/* ---- APPROVAL SECTION ---- */
.approval-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-bottom: 48px;
}
.approval-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 28px 24px;
  position: relative;
}
.approval-number {
  font-family: 'Playfair Display', serif;
  font-size: 64px;
  font-weight: 900;
  color: rgba(255,255,255,0.04);
  position: absolute;
  top: 12px; right: 20px;
  line-height: 1;
  pointer-events: none;
}
.approval-card h3 {
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12px;
  line-height: 1.3;
}
.approval-card p {
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  line-height: 1.7;
}

/* ---- FOOTER ---- */
footer {
  background: var(--navy);
  padding: 48px;
  border-top: 1px solid rgba(255,255,255,0.06);
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.footer-logo {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  color: #fff;
}
.footer-logo span { color: var(--gold); }
.footer-right {
  font-size: 12px;
  color: rgba(255,255,255,0.25);
  text-align: right;
  line-height: 1.8;
}

/* ---- ANIMATIONS ---- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ---- RESPONSIVE ---- */
@media (max-width: 768px) {
  nav { padding: 16px 20px; }
  .nav-links { display: none; }
  section { padding: 64px 20px; }
  .hero { padding: 0 20px 64px; }
  .metric-grid, .dark-metric-grid { grid-template-columns: 1fr 1fr; }
  .chart-grid, .chart-grid-3 { grid-template-columns: 1fr; }
  .chart-full { grid-column: 1; }
  .owner-grid { grid-template-columns: 1fr; }
  .approval-grid { grid-template-columns: 1fr; }
  .hero-stats { gap: 24px; flex-wrap: wrap; }
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">KELD <span>Matrix</span></div>
  <div class="nav-links">
    <a href="#kumba">Kumba ROI</a>
    <a href="#keld">KELD MC ROI</a>
    <a href="#model">Commercial Model</a>
    <a href="#approval">Investment Case</a>
  </div>
</nav>

<!-- HERO -->
<div class="hero">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>
  <div class="hero-glow-2"></div>

  <div class="hero-tag">KELD Matrix Consulting · Phase 4 · 2026</div>
  <h1 class="hero-title">
    Commercialisation<br>& <em>Return on</em><br>Investment
