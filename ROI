// ---- KELD MC MAIN CHART ----
function buildKeldScenario(scenario){
  const months=36;
  const fixedMonthly=(1500000*4*0.4/12)+(400000+180000+120000)/36;
  let rev=new Array(months+1).fill(0);
  let cost=new Array(months+1).fill(0);
  rev[0]+=350000; rev[2]+=1250000; rev[5]+=2800000;
  for(let m=6;m<=months;m++) rev[m]+=75000;
  if(scenario==='kolomela'||scenario==='group'){
    rev[14]+=1750000;
    for(let m=20;m<=months;m++) rev[m]+=62500;
  }
  if(scenario==='group'){
    rev[20]+=2000000; rev[26]+=2000000; rev[32]+=2000000;
    for(let m=26;m<=months;m++) rev[m]+=50000;
  }
  for(let m=0;m<=months;m++){
    cost[m]=fixedMonthly;
    if(m<=2) cost[m]+=80000;
    if(m>=5&&m<=8) cost[m]+=120000;
    if(scenario!=='base'&&m>=14&&m<=17) cost[m]+=80000;
    if(scenario==='group'){
      if(m>=20&&m<=23) cost[m]+=60000;
      if(m>=26&&m<=29) cost[m]+=60000;
      if(m>=32&&m<=35) cost[m]+=60000;
    }
  }
  let cumRev=[],cumCost=[],cumNet=[];
  let cR=0,cC=0;
  for(let m=0;m<=months;m++){
    cR+=rev[m]; cC+=cost[m];
    cumRev.push(Math.round(cR/1000)); cumCost.push(Math.round(cC/1000)); cumNet.push(Math.round((cR-cC)/1000));
  }
  return{cumRev,cumCost,cumNet};
}

const keldLabels=Array.from({length:37},(_,i)=>i%6===0?`M${i}`:'');
let keldChart;
function buildKeldMain(scenario){
  const d=buildKeldScenario(scenario);
  const notes={
    base:'* Base: Sishen only. 4-person team, 40% allocation, R1.5M loaded annual cost each. Break-even ~Month 14.',
    kolomela:'* Includes Kolomela at Month 14 (R1.75M). Reused architecture ~50% lower delivery cost. Earlier break-even.',
    group:'* Includes 3 Anglo American group deployments from Month 20 (R2M each). Demonstrates product replication upside.'
  };
  document.getElementById('keldNote').textContent=notes[scenario];
  if(keldChart) keldChart.destroy();
  keldChart=new Chart(document.getElementById('keldMain'),{
    type:'line',
    data:{
      labels:keldLabels,
      datasets:[
        {label:'Cumulative revenue',data:d.cumRev,borderColor:GOLD,backgroundColor:'rgba(201,168,76,0.05)',borderWidth:2,pointRadius:0,fill:false,tension:0.3},
        {label:'Cumulative cost',data:d.cumCost,borderColor:RED,backgroundColor:'rgba(232,112,96,0.05)',borderWidth:2,pointRadius:0,fill:false,tension:0.3},
        {label:'Net position',data:d.cumNet,borderColor:TEAL,backgroundColor:'rgba(29,158,117,0.08)',borderWidth:2,pointRadius:0,fill:true,tension:0.3,borderDash:[5,3]},
      ]
    },
    options:{
      responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>`${ctx.dataset.label}: R${ctx.parsed.y.toLocaleString()}K`}}},
      scales:{
        x:{ticks:{font:{size:11},color:'rgba(255,255,255,0.3)'},grid:{color:'rgba(255,255,255,0.04)'}},
        y:{ticks:{font:{size:11},color:'rgba(255,255,255,0.3)',callback:v=>`R${v}K`},grid:{color:'rgba(255,255,255,0.04)'}}
      }
    }
  });
}
buildKeldMain('base');

function setScenario(s,btn){
  document.querySelectorAll('.s-tab').forEach(t=>t.classList.remove('active'));
  btn.classList.add('active');
  buildKeldMain(s);
}

